# ============================================================================
#  nest-de-hieu-v2 — biến môi trường
#  Sao chép thành .env rồi điền giá trị thật. Không commit .env.
# ============================================================================

# ---------------------------------------------------------------- App (HTTP)
# Cổng HTTP của app (API điều khiển + query). Mặc định 3000.
PORT=3000
HTTP_BIND_HOST=0.0.0.0
# Tài liệu API (Swagger UI) tại http://<host>:PORT/docs, JSON tại /docs-json. Đặt false để tắt.
API_DOCS_ENABLED=true
# Log HTTP lỗi, phản hồi >= 1 giây và kết nối bị ngắt. true = ghi cả phản hồi thành công.
# Chỉ ghi mã yêu cầu, route mẫu, mã HTTP, thời gian; không ghi dữ liệu hay token.
HTTP_DIAGNOSTICS_LOG_SUCCESS=false

# ---------------------------------------------------------------- PostgreSQL (Supabase)
# Copy connection string từ Supabase > Connect. Không phải Supabase API URL/key.
# VPS IPv4: Session pooler (5432); IPv6: có thể dùng Direct connection.
# Không dùng Transaction pooler (6543) với driver hiện tại. Encode mật khẩu trong URL.
# sslmode=require mã hóa kết nối; verify-full cần CA tin cậy để xác minh server.
# Thay host/user/ref/password bằng giá trị thật; không commit .env.
DATABASE_URL='postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require'
# Số kết nối Postgres tối đa mỗi tiến trình backend (mặc định 5). Supabase pooler cổng 5432 giới hạn
# tổng client: chạy cả local lẫn server cùng một database thì giữ nhỏ, hoặc dùng cổng 6543 (transaction mode).
# DATABASE_POOL_MAX=5

# ---------------------------------------------------------------- Store (Dragonfly / Redis)
# Mật khẩu cho container Dragonfly trong docker-compose.yml (bắt buộc khi chạy compose).
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM
# URL app dùng để kết nối store. Dragonfly nói giao thức Redis nên dùng redis:// như thường.
REDIS_URL=redis://:CHANGE_ME_LONG_RANDOM@127.0.0.1:6379

# ---------------------------------------------------------------- WebSocket chung
# Địa chỉ nghe của cả 3 WebSocket server (3001/3002/3003). Đứng sau reverse proxy TLS cùng máy
# (xem deploy/README.md) → 127.0.0.1 để các cổng này không lộ ra internet.
WS_BIND_HOST=0.0.0.0

# ---------------------------------------------------------------- Kênh publisher (microservice → app)
# App mở WebSocket server ở cổng này cho các node task-runner kết nối vào.
TASK_WS_PORT=3001
# Token dùng chung giữa app và mọi node task-runner (>= 16 ký tự). Tạo: openssl rand -hex 32
TASK_WS_TOKEN=CHANGE_ME_AT_LEAST_16_CHARS
# Frame tối đa từ node (MB). Snapshot / trang danh sách trận có thể lớn.
TASK_WS_MAX_PAYLOAD_MB=64

# ---------------------------------------------------------------- Kênh consumer (app → Discord bot, auto-trade)
CONSUMER_WS_PORT=3002
# Token consumer gửi trong frame hello (>= 16 ký tự). Nên KHÁC TASK_WS_TOKEN và API_TOKENS.
CONSUMER_WS_TOKEN=CHANGE_ME_AT_LEAST_16_CHARS

# ---------------------------------------------------------------- Auto trade
# Mặc định chỉ 4 môn esports được đặt lệnh thật. Cho phép riêng các môn mới trên
# tiến trình chạy trader (backend hoặc task-runner), ví dụ: soccer,basketball,tennis.
# Việc bật môn không đổi profile từ giấy sang thật.
TRADING_LIVE_SPORTS=
# Khóa chủ mã hóa private key của MỌI ví polymarket (>= 32 ký tự). Trống = không lưu được private key.
# Tạo: openssl rand -base64 48 · Đổi/mất khóa = phải nhập lại mọi private key.
TRADING_SECRET_KEY=
# Profile Chromium bền vững (mỗi tài khoản csgoempire một thư mục).
TRADING_BROWSER_ROOT=.trading/profiles
# SeleniumBase (default) owns Chrome; Playwright connects over loopback CDP.
# Install: python -m pip install -r requirements.txt
TRADING_BROWSER_ENGINE=seleniumbase
# Python executable, e.g. C:/Code/nest-de-hieu-v2/.venv/Scripts/python.exe
# TRADING_PYTHON_PATH=python
# Use TRADING_BROWSER_ENGINE=playwright for the native Playwright launcher.
# Nếu dùng Chromium hệ thống:
# TRADING_CHROMIUM_PATH=/usr/bin/chromium
# Chromium có giao diện: chạy app dưới Xvfb và bật biến này.
# TRADING_BROWSER_HEADED=1
# TRADING_DEBUG_PORT=9222
# Số Chrome tối đa cùng mở (làm mới phiên + đăng nhập tay + kiểm tra số dư). Mỗi cái ~300-500 MB RAM.
# Làm mới phiên nền chờ chỗ tối đa 60 giây; hết chỗ mà token cũ còn hạn thì dùng tiếp token cũ.
# Mỗi tài khoản csgoempire đang chạy THẬT giữ 1 Chrome nền đọc số dư (csgoempire chỉ trả số dư cho
# trình duyệt thật): đặt ≥ số tài khoản Empire chạy thật + 1 (chỗ cho làm mới phiên / đăng nhập).
TRADING_MAX_BROWSERS=2
# Nhịp Chrome nền đọc số dư csgoempire (ms). Mặc định 2000 (2 giây), tối thiểu 1000. Sàn từ chối liên
# tiếp thì tự giãn nhịp (×2 mỗi lần, tối đa 60 giây) rồi về lại nhịp này khi đọc được.
TRADING_EMPIRE_BALANCE_INTERVAL_MS=2000

# ---------------------------------------------------------------- Xác thực + phân quyền API
# Danh sách token: "token:principalId:role1|role2" phân tách bằng dấu phẩy. Rỗng = không ai gọi được API.
# Vai trò mặc định: admin (mọi quyền), manager, staff, viewer (chỉ đọc). Gọi API với header
#   Authorization: Bearer <token>
API_TOKENS=CHANGE_ME_ADMIN_TOKEN:alice:admin,CHANGE_ME_VIEWER_TOKEN:bob:viewer
# (Tùy chọn) Thêm/ghi đè vai trò → quyền bằng JSON, không cần sửa code:
# ROLE_PERMISSIONS={"moderator":["team-aliases:*","arbitrage:read"]}

# ============================================================================
#  Chỉ dành cho microservice task-runner (pnpm start:task-runner)
#  Mỗi tiến trình task-runner cần một NODE_ID riêng; TASK_WS_TOKEN phải trùng với app.
# ============================================================================
TASK_RUNNER_NODE_ID=node-1
# Cùng máy với app: ws://127.0.0.1:3001 · qua internet (sau proxy TLS): wss://api.example.com/task-ws
TASK_RUNNER_APP_URL=ws://127.0.0.1:3001

# Ghi chú: URL/brand của sptpub, tagIds của polymarket, tần suất fetch... KHÔNG nằm ở đây.
# Chúng là tham số của từng publisher, truyền khi tạo qua POST /tasks, ví dụ:
#   { "taskId": "sptpub-live", "kind": "sptpub.live",
#     "runtime": { "type": "worker" },
#     "params": { "baseUrl": "https://api-h-xxxx.sptpub.com", "brandId": "...", "lang": "en",
#                 "intervalMs": 1000 } }

# ---------- Vận hành (admin)
# WebSocket cho dashboard admin (hello bằng token trong API_TOKENS, cần quyền admin:read)
ADMIN_WS_PORT=3003
# Discord webhook nhận cảnh báo sự cố (để trống = chỉ ghi log). Đây là BÍ MẬT, đừng commit.
DISCORD_ALERT_WEBHOOK_URL=
# ---------- OneSignal: báo về điện thoại khi có kèo mới ở On click (trống = tắt)
# App ID giống NEXT_PUBLIC_ONESIGNAL_APP_ID của web. REST API Key ở OneSignal > Settings > Keys & IDs — BÍ MẬT, đừng commit.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
# Gốc web Arb Ops (vd https://arbops.vercel.app): bấm thông báo mở thẳng trang On click
WEB_APP_URL=
# Số ngày giữ lịch sử chuyển trạng thái odds
ODDS_TRANSITION_RETENTION_DAYS=7
# Số ngày giữ (dọn mỗi ngày, theo lô): lịch sử kèo đã kết thúc / sự cố đã đóng / audit
SIGNAL_HISTORY_RETENTION_DAYS=90
INCIDENT_RETENTION_DAYS=180
AUDIT_RETENTION_DAYS=365

# ---------- Dọn dòng kèo
# Xóa sạch room trong Redis lúc khởi động (dòng cũ không còn bảng định tuyến → mồ côi). true | false
RESET_ROOMS_ON_START=true
# Quá giờ bắt đầu + ngần này giờ → coi trận đã xong, gỡ dòng kèo (lý do match_expired)
MATCH_MAX_DURATION_HOURS=8

